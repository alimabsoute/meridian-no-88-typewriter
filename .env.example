# Server-only signup settings. Never use a VITE_ prefix for these values.
# See docs/updates-signup.md. Leave blank until the private collector is deployed.
OCTOBERLINE_UPDATES_WEBHOOK_URL=
OCTOBERLINE_UPDATES_WEBHOOK_SECRET=
# Set to pulse only when reusing the verified Pulse Apps Script collector.
# The default signed format uses the dedicated receiver and secret above.
OCTOBERLINE_UPDATES_WEBHOOK_FORMAT=signed
